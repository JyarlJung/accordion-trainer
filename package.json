{
  "name": "accordion-trainer",
  "private": true,
  "version": "0.2.2",
  "license": "MIT",
  "type": "module",
  "main": "electron/main.js",
  "scripts": {
    "dev": "vite",
    "app": "node scripts/dev-electron.js",
    "build": "tsc --noEmit && vite build",
    "typecheck": "tsc --noEmit",
    "dist": "npm run build && electron-builder --win portable"
  },
  "build": {
    "appId": "local.accordion-trainer",
    "productName": "Accordion Trainer",
    "files": [
      "dist/**",
      "electron/**",
      "package.json"
    ],
    "directories": {
      "output": "release"
    }
  },
  "devDependencies": {
    "@tonejs/midi": "^2.0.28",
    "electron": "^44.7.0",
    "electron-builder": "^26.15.3",
    "spessasynth_core": "4.3.22",
    "spessasynth_lib": "4.3.14",
    "typescript": "^7.0.2",
    "vite": "^8.3.4"
  }
}
